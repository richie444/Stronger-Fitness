# Copy this file to .env and provide your own local or hosted PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# Set this only when the frontend and backend are deployed on different domains.
# VITE_API_URL=https://your-backend.onrender.com
